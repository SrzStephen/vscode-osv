{
  "name": "vscode-osv",
  "displayName": "OSV Vulnerabilities",
  "description": "Highlights known vulnerabilities (OSV.dev) in dependency manifests and lockfiles, with one-click fixes.",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SrzStephen/vscode-osv.git",
    "directory": "packages/vscode-osv"
  },
  "homepage": "https://github.com/SrzStephen/vscode-osv/tree/main/packages/vscode-osv#readme",
  "bugs": {
    "url": "https://github.com/SrzStephen/vscode-osv/issues"
  },
  "publisher": "srzstephen",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "osv",
    "vulnerability",
    "security",
    "dependencies",
    "lockfile"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Lock commands are disabled in Restricted Mode.",
      "restrictedConfigurations": [
        "osv.apiBaseUrl",
        "osv.caCertificatePath",
        "osv.offerLockCommand"
      ]
    }
  },
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/package-lock.json",
    "workspaceContains:**/npm-shrinkwrap.json",
    "workspaceContains:**/yarn.lock",
    "workspaceContains:**/pnpm-lock.yaml",
    "workspaceContains:**/bun.lock",
    "workspaceContains:**/requirements*.txt",
    "workspaceContains:**/requirements/*.txt",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/Pipfile",
    "workspaceContains:**/poetry.lock",
    "workspaceContains:**/uv.lock",
    "workspaceContains:**/Pipfile.lock",
    "workspaceContains:**/pdm.lock",
    "workspaceContains:**/pylock.toml",
    "workspaceContains:**/pylock.*.toml",
    "workspaceContains:**/Cargo.toml",
    "workspaceContains:**/Cargo.lock",
    "workspaceContains:**/pom.xml",
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/build.gradle.kts",
    "workspaceContains:**/gradle/libs.versions.toml",
    "workspaceContains:**/gradle.lockfile",
    "workspaceContains:**/buildscript-gradle.lockfile",
    "workspaceContains:**/go.mod",
    "workspaceContains:**/*.csproj",
    "workspaceContains:**/*.fsproj",
    "workspaceContains:**/*.vbproj",
    "workspaceContains:**/Directory.Packages.props",
    "workspaceContains:**/Directory.Build.props",
    "workspaceContains:**/packages.config",
    "workspaceContains:**/packages.lock.json",
    "workspaceContains:**/Gemfile",
    "workspaceContains:**/gems.rb",
    "workspaceContains:**/*.gemspec",
    "workspaceContains:**/Gemfile.lock",
    "workspaceContains:**/gems.locked",
    "workspaceContains:**/composer.json",
    "workspaceContains:**/composer.lock",
    "workspaceContains:**/.github/workflows/*.yml",
    "workspaceContains:**/.github/workflows/*.yaml",
    "workspaceContains:**/action.yml",
    "workspaceContains:**/action.yaml",
    "workspaceContains:**/pubspec.yaml",
    "workspaceContains:**/pubspec.lock",
    "workspaceContains:**/mix.exs",
    "workspaceContains:**/mix.lock",
    "workspaceContains:**/Package.swift",
    "workspaceContains:**/Package.resolved",
    "onLanguage:json",
    "onLanguage:toml",
    "onLanguage:pip-requirements"
  ],
  "contributes": {
    "commands": [
      {
        "command": "osv.scanWorkspaceUi",
        "title": "Scan workspace",
        "category": "OSV",
        "icon": "$(search)"
      },
      {
        "command": "osv.clearCacheUi",
        "title": "Clear cache and rescan",
        "category": "OSV",
        "icon": "$(refresh)"
      },
      {
        "command": "osv.showLog",
        "title": "Show output log",
        "category": "OSV",
        "icon": "$(output)"
      },
      {
        "command": "osv.overview.refresh",
        "title": "Refresh vulnerabilities view",
        "category": "OSV",
        "icon": "$(refresh)"
      },
      {
        "command": "osv.overview.groupBySeverity",
        "title": "Group by severity",
        "category": "OSV",
        "icon": "$(list-tree)"
      },
      {
        "command": "osv.overview.groupByFile",
        "title": "Group by file",
        "category": "OSV",
        "icon": "$(files)"
      },
      {
        "command": "osv.overview.reveal",
        "title": "Reveal in editor",
        "category": "OSV"
      },
      {
        "command": "osv.overview.fix",
        "title": "Apply fix",
        "category": "OSV",
        "icon": "$(lightbulb)"
      },
      {
        "command": "osv.overview.ignore",
        "title": "Ignore vulnerability",
        "category": "OSV",
        "icon": "$(eye-closed)"
      },
      {
        "command": "osv.overview.openAdvisory",
        "title": "Open advisory on osv.dev",
        "category": "OSV",
        "icon": "$(link-external)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "osv",
          "title": "OSV Vulnerabilities",
          "icon": "media/osv-activity.svg"
        }
      ]
    },
    "views": {
      "osv": [
        {
          "id": "osv.overview",
          "name": "Vulnerabilities"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "osv.overview",
        "contents": "No known vulnerabilities found yet.\n[Scan workspace](command:osv.scanWorkspaceUi)\nOpen a dependency manifest or lockfile, or scan the whole workspace, to see results here."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "osv.overview.reveal",
          "when": "false"
        },
        {
          "command": "osv.overview.fix",
          "when": "false"
        },
        {
          "command": "osv.overview.ignore",
          "when": "false"
        },
        {
          "command": "osv.overview.openAdvisory",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "osv.scanWorkspaceUi",
          "when": "view == osv.overview",
          "group": "navigation@1"
        },
        {
          "command": "osv.overview.groupBySeverity",
          "when": "view == osv.overview && config.osv.overview.groupBy != severity",
          "group": "navigation@2"
        },
        {
          "command": "osv.overview.groupByFile",
          "when": "view == osv.overview && config.osv.overview.groupBy == severity",
          "group": "navigation@2"
        },
        {
          "command": "osv.clearCacheUi",
          "when": "view == osv.overview",
          "group": "1_actions@1"
        },
        {
          "command": "osv.showLog",
          "when": "view == osv.overview",
          "group": "1_actions@2"
        }
      ],
      "view/item/context": [
        {
          "command": "osv.overview.fix",
          "when": "view == osv.overview && viewItem == osv.entry.fixable",
          "group": "inline@1"
        },
        {
          "command": "osv.overview.openAdvisory",
          "when": "view == osv.overview && viewItem =~ /^osv\\.entry/",
          "group": "inline@2"
        },
        {
          "command": "osv.overview.ignore",
          "when": "view == osv.overview && viewItem =~ /^osv\\.entry/",
          "group": "inline@3"
        },
        {
          "command": "osv.overview.fix",
          "when": "view == osv.overview && viewItem == osv.entry.fixable",
          "group": "1_fix@1"
        },
        {
          "command": "osv.overview.ignore",
          "when": "view == osv.overview && viewItem =~ /^osv\\.entry/",
          "group": "2_manage@1"
        },
        {
          "command": "osv.overview.openAdvisory",
          "when": "view == osv.overview && viewItem =~ /^osv\\.entry/",
          "group": "2_manage@2"
        }
      ],
      "editor/title": [
        {
          "command": "osv.scanWorkspaceUi",
          "when": "osv.activeFileScanned",
          "group": "navigation@90"
        },
        {
          "command": "osv.clearCacheUi",
          "when": "osv.activeFileScanned",
          "group": "navigation@91"
        }
      ]
    },
    "configuration": {
      "title": "OSV",
      "properties": {
        "osv.overview.groupBy": {
          "type": "string",
          "default": "file",
          "enum": [
            "file",
            "severity"
          ],
          "enumDescriptions": [
            "Group vulnerable dependencies by the file that declares them.",
            "Group vulnerable dependencies by severity."
          ],
          "scope": "window",
          "description": "How the Vulnerabilities view groups findings."
        },
        "osv.enable": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Master switch for OSV vulnerability scanning."
        },
        "osv.ecosystems": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "boolean"
          },
          "scope": "window",
          "description": "Per-ecosystem switches, for example { \"npm\": true, \"pypi\": false }. Ecosystems not listed are enabled."
        },
        "osv.minimumSeverity": {
          "type": "string",
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Hide findings below this severity."
        },
        "osv.onlyShowFixable": {
          "type": "boolean",
          "default": false,
          "description": "Only show vulnerabilities that have an official fix, that is, a fixed version in the OSV record. Vulnerabilities with no fix yet are hidden. Severity is still scored from CVSS (v3 and v4) and filtered separately by osv.minimumSeverity."
        },
        "osv.scanLockfiles": {
          "type": "boolean",
          "default": true,
          "description": "Highlight vulnerable entries inside lockfiles."
        },
        "osv.scanWorkspaceOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Run a workspace scan when the server starts."
        },
        "osv.cacheTtlHours": {
          "type": "number",
          "default": 48,
          "minimum": 1,
          "description": "How long package results stay fresh, in hours (minimum 1)."
        },
        "osv.apiBaseUrl": {
          "type": "string",
          "default": "https://api.osv.dev",
          "description": "Base URL of the OSV API (for a mirror or proxy). Only package name, version and ecosystem are sent."
        },
        "osv.caCertificatePath": {
          "type": "string",
          "default": "",
          "description": "Path to a PEM file of CA certificates to trust in addition to the default trust store, e.g. for a TLS-inspecting proxy. Empty uses the SSL_CERT_FILE environment variable (and every .pem or .crt file in SSL_CERT_DIR is also trusted), or only the default store when those are unset."
        },
        "osv.ignoredVulnerabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Vulnerability IDs (any alias) to suppress."
        },
        "osv.offerLockCommand": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Ask before running the lockfile update command.",
            "Run the lockfile update command in the OSV terminal automatically.",
            "Never offer or run lockfile update commands."
          ],
          "description": "Whether to run the package manager command that refreshes the lockfile after a manifest fix. Never runs in Restricted Mode."
        }
      }
    }
  },
  "scripts": {
    "build": "node --import tsx build.mts",
    "test:integration": "node --import tsx build.mts --test && node dist/test/runTest.js",
    "package": "node --import tsx build.mts && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.90.0",
    "mocha": "^11.7.5",
    "vscode-languageclient": "^9.0.1"
  }
}
